REQUIRE preamble.ft
default-spaces!
REQUIRE assembler.ft

VARIABLE start-depth

4 CONSTANT instr-width \ TODO: This should probably just be removed?

VARIABLE error?
error? off

: error error? on   type source type cr ;

: code-base ( -- tgt-addr ) code-space space>org @ ;

: T{ code-base code-space !   depth start-depth ! ;

: -> depth start-depth @ <> IF S" Stack not clean during assembly " error THEN ;

: }T depth start-depth @ <= IF S" Empty expectation " error THEN
  code-space @ BEGIN instr-width    - dup code-base >= WHILE ( ... exp tgt-addr )
    tuck tcode@ <> IF S" Mismatch " error THEN ( ... tgt-addr )
  REPEAT drop
  depth start-depth @ swap - IF S" Expectation longer than actual " error THEN ;

\ Branches ===================================================================
T{ code-base            b, -> $eafffffe }T
T{ code-base $100 +     b, -> $ea00003e }T
T{ code-base $100 + ne? b, -> $1a00003e }T


\ Data Processing ============================================================
T{ r0   r1 r2     add, -> $e0812000 }T
T{ r0   r1 r2 S   add, -> $e0912000 }T
T{ 14 # r1 r2 lt? add, -> $b281200e }T
T{ 14 # r1 r2 S   add, -> $e291200e }T

T{ 14   #     r2 tst, -> $e312000e }T
T{ 1200 #     r2 tst, -> $e3120e4b }T  \ 1200 = $4b0 = 01001011 ROR 28 -> $e4b
T{ r6 2 # lsr r2 tst, -> $e1120126 }T

T{ r3    r4   mov, -> $e1a04003 }T
T{ 300 # r4 S mvn, -> $e3f04f4b }T \ 300 = $12c = 01001011 ROR 30 -> $f4b


\ Single Data Transfer - LDR and STR =========================================
T{            r4 []   r8 ldr, -> $e5948000 }T
T{       ne?  r4 []   r8 ldr, -> $15948000 }T
T{ r3         r4 [+]  r8 ldr, -> $e7948003 }T
T{ r3 2 # lsl r4 [+]  r8 ldr, -> $e7948103 }T
T{ r3 6 # asr r4 [+]  r8 ldr, -> $e7948343 }T
T{ r3 r2  lsr r4 [+]  r8 ldr, -> $e7948233 }T
T{ r3 r2  lsr r4 [+]! r8 ldr, -> $e7b48233 }T

\ Working through all the bit combinations: UBWL
T{ $abc #     r4 [-]  r8 str,  -> $e5048abc }T  \ ubwl
T{ $abc #     r4 [-]  r8 ldr,  -> $e5148abc }T  \ ubwL
T{ $abc #     r4 [-]! r8 str,  -> $e5248abc }T  \ ubWl
T{ $abc #     r4 [-]! r8 ldr,  -> $e5348abc }T  \ ubWL
T{ $abc #     r4 [-]  r8 strb, -> $e5448abc }T  \ uBwl
T{ $abc #     r4 [-]  r8 ldrb, -> $e5548abc }T  \ uBwL
T{ $abc #     r4 [-]! r8 strb, -> $e5648abc }T  \ uBWl
T{ $abc #     r4 [-]! r8 ldrb, -> $e5748abc }T  \ uBWL
T{ $abc #     r4 [+]  r8 str,  -> $e5848abc }T  \ Ubwl
T{ $abc #     r4 [+]  r8 ldr,  -> $e5948abc }T  \ UbwL
T{ $abc #     r4 [+]! r8 str,  -> $e5a48abc }T  \ UbWl
T{ $abc #     r4 [+]! r8 ldr,  -> $e5b48abc }T  \ UbWL
T{ $abc #     r4 [+]  r8 strb, -> $e5c48abc }T  \ UBwl
T{ $abc #     r4 [+]  r8 ldrb, -> $e5d48abc }T  \ UBwL
T{ $abc #     r4 [+]! r8 strb, -> $e5e48abc }T  \ UBWl
T{ $abc #     r4 [+]! r8 ldrb, -> $e5f48abc }T  \ UBWL

\ PC-relative loads ==========================================================
T{ code-space space>org @   $978 +   r3 ldr-pc, -> $e59f3970 }T
T{ code-space space>org @   16   -   r3 ldr-pc, -> $e51f3018 }T


\ Halfwords - LDRH and STRH ==================================================
\ Register offset:  cccc 000P UIWL nnnn dddd 0000 1oo1 mmmm
\ Immediate offset: cccc 000P UIWL nnnn dddd iiii 1oo1 iiii
\ oo   L=0      L=1
\ 0    SWAP     (reserved)   Not really part of this
\ 1    STRH     LDRH         Unsigned (zero-extended) halfwords
\ 2    (dword)  LDRSB        Load sign-extended byte
\ 3    (dword)  LDRSH        Load sign-extended halfword

\ LDRH
T{       r4 []    r8 ldrh,  -> $e1d480b0 }T \ Default: Pre, Imm=$00, PUIwL
T{  ne?  r4 []    r8 ldrh,  -> $11d480b0 }T \ Same, with a condition
T{ $67 # r4 [+]   r8 ldrh,  -> $e1d486b7 }T \ Pre,  Imm=$67, PUIwL
T{ $67 # r4 [+]!  r8 ldrh,  -> $e1f486b7 }T \ Pre,  Imm=$67, PUIWL
T{ $67 # r4 [-]   r8 ldrh,  -> $e15486b7 }T \ Pre,  Imm=$67, PuIwL
T{ $67 # r4 [-]!  r8 ldrh,  -> $e17486b7 }T \ Pre,  Imm=$67, PuIWL
T{ $67 # r4 []+   r8 ldrh,  -> $e0d486b7 }T \ Post, Imm=$67, pUIwL
T{ $67 # r4 []-   r8 ldrh,  -> $e05486b7 }T \ Post, Imm=$67, puIwL
T{ r5    r4 [+]   r8 ldrh,  -> $e19480b5 }T \ Pre,  Reg r5,  PUiwL
T{ r5    r4 [+]!  r8 ldrh,  -> $e1b480b5 }T \ Pre,  Reg r5,  PUiWL
T{ r5    r4 [-]   r8 ldrh,  -> $e11480b5 }T \ Pre,  Reg r5,  PuiwL
T{ r5    r4 [-]!  r8 ldrh,  -> $e13480b5 }T \ Pre,  Reg r5,  PuiWL
T{ r5    r4 []+   r8 ldrh,  -> $e09480b5 }T \ Post, Reg r5,  pUiwL
T{ r5    r4 []-   r8 ldrh,  -> $e01480b5 }T \ Post, Reg r5,  puiwL

\ LDRSH
T{       r4 []    r8 ldrsh, -> $e1d480f0 }T \ Default: Pre, Imm=$00, PUIwL
T{  ne?  r4 []    r8 ldrsh, -> $11d480f0 }T \ Same, with a condition
T{ $67 # r4 [+]   r8 ldrsh, -> $e1d486f7 }T \ Pre,  Imm=$67, PUIwL
T{ $67 # r4 [+]!  r8 ldrsh, -> $e1f486f7 }T \ Pre,  Imm=$67, PUIWL
T{ $67 # r4 [-]   r8 ldrsh, -> $e15486f7 }T \ Pre,  Imm=$67, PuIwL
T{ $67 # r4 [-]!  r8 ldrsh, -> $e17486f7 }T \ Pre,  Imm=$67, PuIWL
T{ $67 # r4 []+   r8 ldrsh, -> $e0d486f7 }T \ Post, Imm=$67, pUIwL
T{ $67 # r4 []-   r8 ldrsh, -> $e05486f7 }T \ Post, Imm=$67, puIwL
T{ r5    r4 [+]   r8 ldrsh, -> $e19480f5 }T \ Pre,  Reg r5,  PUiwL
T{ r5    r4 [+]!  r8 ldrsh, -> $e1b480f5 }T \ Pre,  Reg r5,  PUiWL
T{ r5    r4 [-]   r8 ldrsh, -> $e11480f5 }T \ Pre,  Reg r5,  PuiwL
T{ r5    r4 [-]!  r8 ldrsh, -> $e13480f5 }T \ Pre,  Reg r5,  PuiWL
T{ r5    r4 []+   r8 ldrsh, -> $e09480f5 }T \ Post, Reg r5,  pUiwL
T{ r5    r4 []-   r8 ldrsh, -> $e01480f5 }T \ Post, Reg r5,  puiwL

\ LDRSB
T{       r4 []    r8 ldrsb, -> $e1d480d0 }T \ Default: Pre, Imm=$00, PUIwL
T{  ne?  r4 []    r8 ldrsb, -> $11d480d0 }T \ Same, with a condition
T{ $67 # r4 [+]   r8 ldrsb, -> $e1d486d7 }T \ Pre,  Imm=$67, PUIwL
T{ $67 # r4 [+]!  r8 ldrsb, -> $e1f486d7 }T \ Pre,  Imm=$67, PUIWL
T{ $67 # r4 [-]   r8 ldrsb, -> $e15486d7 }T \ Pre,  Imm=$67, PuIwL
T{ $67 # r4 [-]!  r8 ldrsb, -> $e17486d7 }T \ Pre,  Imm=$67, PuIWL
T{ $67 # r4 []+   r8 ldrsb, -> $e0d486d7 }T \ Post, Imm=$67, pUIwL
T{ $67 # r4 []-   r8 ldrsb, -> $e05486d7 }T \ Post, Imm=$67, puIwL
T{ r5    r4 [+]   r8 ldrsb, -> $e19480d5 }T \ Pre,  Reg r5,  PUiwL
T{ r5    r4 [+]!  r8 ldrsb, -> $e1b480d5 }T \ Pre,  Reg r5,  PUiWL
T{ r5    r4 [-]   r8 ldrsb, -> $e11480d5 }T \ Pre,  Reg r5,  PuiwL
T{ r5    r4 [-]!  r8 ldrsb, -> $e13480d5 }T \ Pre,  Reg r5,  PuiWL
T{ r5    r4 []+   r8 ldrsb, -> $e09480d5 }T \ Post, Reg r5,  pUiwL
T{ r5    r4 []-   r8 ldrsb, -> $e01480d5 }T \ Post, Reg r5,  puiwL

\ STRH
T{       r4 []    r8 strh,  -> $e1c480b0 }T \ Default: Pre, Imm=$00, PUIwl
T{  ne?  r4 []    r8 strh,  -> $11c480b0 }T \ Same, with a condition
T{ $67 # r4 [+]   r8 strh,  -> $e1c486b7 }T \ Pre,  Imm=$67, PUIwl
T{ $67 # r4 [+]!  r8 strh,  -> $e1e486b7 }T \ Pre,  Imm=$67, PUIWl
T{ $67 # r4 [-]   r8 strh,  -> $e14486b7 }T \ Pre,  Imm=$67, PuIwl
T{ $67 # r4 [-]!  r8 strh,  -> $e16486b7 }T \ Pre,  Imm=$67, PuIWl
T{ $67 # r4 []+   r8 strh,  -> $e0c486b7 }T \ Post, Imm=$67, pUIwl
T{ $67 # r4 []-   r8 strh,  -> $e04486b7 }T \ Post, Imm=$67, puIwl
T{ r5    r4 [+]   r8 strh,  -> $e18480b5 }T \ Pre,  Reg r5,  PUiwl
T{ r5    r4 [+]!  r8 strh,  -> $e1a480b5 }T \ Pre,  Reg r5,  PUiWl
T{ r5    r4 [-]   r8 strh,  -> $e10480b5 }T \ Pre,  Reg r5,  Puiwl
T{ r5    r4 [-]!  r8 strh,  -> $e12480b5 }T \ Pre,  Reg r5,  PuiWl
T{ r5    r4 []+   r8 strh,  -> $e08480b5 }T \ Post, Reg r5,  pUiwl
T{ r5    r4 []-   r8 strh,  -> $e00480b5 }T \ Post, Reg r5,  puiwl


\ Multiple Data Transfer - LDM and STM =======================================
T{ {{ r1 r5 r7 }} r4   stmda,   -> $e80400a2 }T  \ puwl
T{ {{ r1 r5 r7 }} r4   ldmda,   -> $e81400a2 }T  \ puwL
T{ {{ r1 r5 r7 }} r4  !stmda,   -> $e82400a2 }T  \ puWl
T{ {{ r1 r5 r7 }} r4  !ldmda,   -> $e83400a2 }T  \ puWL
T{ {{ r1 r5 r7 }} r4   stmia,   -> $e88400a2 }T  \ pUwl
T{ {{ r1 r5 r7 }} r4   ldmia,   -> $e89400a2 }T  \ pUwL
T{ {{ r1 r5 r7 }} r4  !stmia,   -> $e8a400a2 }T  \ pUWl
T{ {{ r1 r5 r7 }} r4  !ldmia,   -> $e8b400a2 }T  \ pUWL
T{ {{ r1 r5 r7 }} r4   stmdb,   -> $e90400a2 }T  \ Puwl
T{ {{ r1 r5 r7 }} r4   ldmdb,   -> $e91400a2 }T  \ PuwL
T{ {{ r1 r5 r7 }} r4  !stmdb,   -> $e92400a2 }T  \ PuWl
T{ {{ r1 r5 r7 }} r4  !ldmdb,   -> $e93400a2 }T  \ PuWL
T{ {{ r1 r5 r7 }} r4   stmib,   -> $e98400a2 }T  \ PUwl
T{ {{ r1 r5 r7 }} r4   ldmib,   -> $e99400a2 }T  \ PUwL
T{ {{ r1 r5 r7 }} r4  !stmib,   -> $e9a400a2 }T  \ PUWl
T{ {{ r1 r5 r7 }} r4  !ldmib,   -> $e9b400a2 }T  \ PUWL

T{ {{ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 sp lr pc }} r4  !ldmib,   -> $e9b4ffff }T

T{ {{ r2 }} r4  ne? ldmia,   -> $18940004 }T
T{ {{ r2 }}         push,    -> $e92d0004 }T
T{ {{ r2 }}         pop,     -> $e8bd0004 }T


