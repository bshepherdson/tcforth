\ Interrupt handling =========================================================
\ ARM has 13 regular registers: r0 through r12.
\ That includes all of the Forth registers!
\ Only SP (r13) and LR (r14) are banked for the different modes.

\ CPU Modes:
\ usr - Classic; but I'm not using it.
\ sys - "System" mode users the User registers but can do privileged things
\ svc - Supervisor mode (Kernel mode, what we start in)
\ mon - Monitor mode only exists with the security extensions
\ abt - Abort mode is for memory errors
\ und - Undefined mode is for bad instructions
\ irq - IRQ mode for regular interrupts
\ fiq - FIQ mode ("fast IRQ") has banked r8-r14, but it's not used here.

\ During startup, we're in Supervisor mode, and we set up its stack.
\ We should be setting up the other stack pointers too - we can force a change:
\ mov sp, something
\ mov r7, sp
\ msr CPSR_c, #0xDF    - System mode
\ mov sp, r7
\ msr CPSR_c, #0xD3    - Supervisor mode

\ mov r0, #0x10
\ msr SPSR, r0
\ ldr lr, =code


\ It's not safe to run Forth code freely because it might be using scratch
\ registers. We would have to be careful about how many we use.
\ We use r0-r4, and r8-r12 for Forth, so those are what needs saving.

\ An alternative approach is to hijack some core instruction in the Forth
\ system to trigger the Forth interrupt handler.
\ I think the best combo approach is to check the basics directly with assembly
\ code: timers, serial input, VBlank.
\ If they want to run Forth code, it's a simple bit of code to enable a task
\ to run next.
\ For a prompt PAUSE we can hijack the codeword of EXIT to a new word that
\ does an EXIT and a (PAUSE) right after.

label 'main-task   task-area0  asm,
label timer-intclr $101e200c   asm, \ Set to 1 to clear the interrupt flag.

TVARIABLE ticks
label 'ticks ticks asm,

TVARIABLE kernel-task

label interrupt-return
  {{ r0 r1 r2 r3 r4   r9 r10 r11 r12 lr }} pop,
  4 # lr  pc  S sub,       \ LR is 4 bytes too far for hardware reasons.

label 'var_handler   var_handler asm,

\ TODO: Currently this assumes the only interrupt source is the timer.
\ XXX: IRQ+ and IRQ- do nothing - interrupts are permanently disabled.
label interrupt-handler
  \ Push all the used registers - r0-r4, r9-r12. (r13 and r14 are banked.)
  \ That includes saving the original UP, so we can just overwrite it.
  {{ r0 r1 r2 r3 r4   r9 r10 r11 r12 lr }} push, \ LR too just in case.
  'main-task     up ldr-pc,   \ Kernel Task -> UP
  \ At its SP is the IP, which we should change to its own code area.
  'var_handler   r0 ldr-pc,   \ Get the address of the HANDLER var.
  r0 []          r0 ldr,      \ xt for interrupt handling -> r0

  ttask-code # up [+] r1 ldr, \ thread -> r1
  r1              []  r0 str, \ xt -> thread[0]
  interrupt-return r0 nearby,
  4 # r1          [+] r0 str, \ int-ret -> thread[1]

  tsp   # up [+] sp str,      \ Store the task's SP to the SP slot.
  sp         []  r1 str,      \ Store the thread into the IP slot.
  trp0  # up [+] r1 ldr,      \ RP0 -> r1
  4     # sp [+] r1 str,      \ RP0 -> rsp slot

  \ Now the thread is ready, so we can unpause it!
  inner-pause       b,


  \ timer-intclr  r0 ldr-pc,
  \ 1 #           r1 mov,
  \ r0 []         r1 str,
  \ 'ticks        r0 ldr-pc, \ Pointer to address to ticks cell
  \ r0 []         r1 ldr,    \ Load the tick count
  \ 1 #   r1      r1 add,    \ Increment it
  \ r0 []         r1 str,    \ And write back
  \ {{ r0 r1 }} pop,         \ Restore the registers
  \ 4 # lr  pc  S sub,       \ LR is 4 bytes too far for hardware reasons.


\ Main =======================================================================
label 'sp0     0 asm, \ These get filled in by arm/finalize.ft
label 'rp0     0 asm,

\ IF01 mmmm
\ These have the modes, plus IRQ + FIQ masking and the res1 bit.
\ Use cpsr-int-enable to lock them again.
$00d0 CONSTANT cpsr-mode-usr
$00d2 CONSTANT cpsr-mode-irq
$00d3 CONSTANT cpsr-mode-svc
$00df CONSTANT cpsr-mode-sys

: cpsr-int-enable  ( cpsr -- cpsr' ) cpsr-int-mask invert and ;
: cpsr-int-disable ( cpsr -- cpsr' ) cpsr-int-mask or ;

\ Machine code entry point, jumped to be the first instructions.
label main
  \ Starts with interrupts disabled.
  \ We need to set up a Forth "kernel" task for interrupt handling.
  \ Each ARM mode has its own SP, so we have to set them up ahead of time.
  'main-task     up ldr-pc,   \ Main Task -> UP

  \ We use task-area0 as the IRQ stack pointer, growing downward just below
  \ the tasks.
  cpsr-mode-irq # cpsr msr,   \ Now in IRQ mode
  up              sp   mov,   \ Setting its SP - just below the task area
  cpsr-mode-sys # cpsr msr,   \ Now to System, (ie. User + privileges)

  \ - Each target defines: kernel-task, kernel/rs, and kernel/ds.
  \ - 'sp0 and 'rp0 will be filled in by finalize.ft, after all USER vars.
  \ - The stack pointers are set here in main so we can execute Forth code.
  \ - COLD calls INIT-MULTI on multitasking configs
  \ - INIT-MULTI sets the stack sizes and LINK field.
  'rp0             rsp ldr-pc,   \ Main RP0  -> rsp
  trp0  # up [+]   rsp str,      \           -> RP0 field
  'sp0              sp ldr-pc,   \ Main SP0  -> sp:
  tsp0  # up [+]    sp str,      \           -> SP0 field

  \ We need to pretend to do SP! which pops the new TOS off the stack.
  {{ tos }} pop,
  \ Then we overwrite TOS with a marker $deadbeef that helps indicate where the
  \ top of the stack is.
  'deadbeef  tos ldr-pc, \ Marker for debugging the stack.

  cpsr-mode-sys # cpsr msr,

  entry-point r0 ldr-pc, \ entry-point is a variable holding an xt; xt -> r0
  r0 bx,                 \ Jump right into that word's code field.

\ Overwrite the jump target of the entry point at $10000 to be main.
code-space @
$10000 code-space !
main b,
code-space !
