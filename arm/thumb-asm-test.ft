REQUIRE preamble.ft
default-spaces!
REQUIRE thumb-asm.ft

2 CONSTANT instr-width
: instr@ ( tgt-addr -- opcode )
  dup tcode-c@   swap 1+ tcode-c@   8 lshift or ;

REQUIRE asm-test-harness.ft

thumb

\ Thumb 1: Shifts ============================================================
\ 000o oSSS SSss sddd
T{ 31 # r3 r6 lsl-imm, -> $07de }T
T{ 0  # r3 r6 lsl-imm, -> $001e }T
T{ 31 # r3 r6 lsr-imm, -> $0fde }T
T{ 0  # r3 r6 lsr-imm, -> $081e }T
T{ 31 # r3 r6 asr-imm, -> $17de }T
T{ 0  # r3 r6 asr-imm, -> $101e }T

\ Thumb 2+3: Add/Sub =========================================================
\ 0001 1oon nnss sddd
T{ 5 # r2 r1 add, -> $1d51 }T \ ADD r1, r2, #5
T{ 5 # r2 r1 sub, -> $1f51 }T \ SUB r1, r2, #5
T{ r5  r2 r1 add, -> $1951 }T \ ADD r1, r2, r5
T{ r5  r2 r1 sub, -> $1b51 }T \ SUB r1, r2, r5
T{ $cd #  r1 add, -> $31cd }T \ ADD r1, #$cd
T{ $cd #  r1 sub, -> $39cd }T \ SUB r1, #$cd

\ Thumb 2+3: MOV =============================================================
T{ $cd #  r1 mov, -> $21cd }T \ MOV r1, #$cd   in immediate form
T{ r4     r1 mov, -> $1c21 }T \ MOV r1, r4     == ADD r1, r4, #0

\ Thumb 3: CMP ===============================================================
T{ $cd # r1 cmp, -> $29cd }T \ CMP

\ Thumb 4: ALU registers =====================================================
T{ r6 r4 and,    -> $4034 }T \ AND r4, r6
T{ r6 r4 eor,    -> $4074 }T \ EOR r4, r6
T{ r6 r4 lsl-rr, -> $40b4 }T \ LSL r4, r6
T{ r6 r4 lsr-rr, -> $40f4 }T \ LSR r4, r6
T{ r6 r4 asr-rr, -> $4134 }T \ ASR r4, r6
T{ r6 r4 adc,    -> $4174 }T \ ADC r4, r6
T{ r6 r4 sbc,    -> $41b4 }T \ SBC r4, r6
T{ r6 r4 ror,    -> $41f4 }T \ ROR r4, r6
T{ r6 r4 tst,    -> $4234 }T \ TST r4, r6
T{ r6 r4 neg,    -> $4274 }T \ NEG r4, r6
T{ r6 r4 cmp,    -> $42b4 }T \ CMP r4, r6
T{ r6 r4 cmn,    -> $42f4 }T \ CMN r4, r6
T{ r6 r4 orr,    -> $4334 }T \ ORR r4, r6
T{ r6 r4 mul,    -> $4374 }T \ MUL r4, r6
T{ r6 r4 bic,    -> $43b4 }T \ BIC r4, r6
T{ r6 r4 mvn,    -> $43f4 }T \ MVN r4, r6


tests-done bye
