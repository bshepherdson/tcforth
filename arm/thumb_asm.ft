\ Thumb assembly counterpart to the ARM assembler.
\ These could be separate vocabularies, or they could be DEFERed words.
\ I think DEFERed words are the most tractable, since the vocabularies are
\ so intertwined for the metacompiler anyway.

REQUIRE assembler.ft

: thumb ( -- )
  thumb:bx,     IS bx,
  thumb:b,      IS b,
  thumb:bl,     IS bl,
  thumb:mul,    IS mul,
  thumb:ldr,    IS ldr,
  thumb:str,    IS str,
  thumb:ldrb,   IS ldrb,
  thumb:strb,   IS strb,
  thumb:ldr-pc, IS ldr-pc,
  thumb:!stmia, IS !stmia,
  thumb:!ldmia, IS !ldmia,
  thumb:push,   IS push,
  thumb:pop,    IS pop,
  thumb:resolve IS resolve ;
