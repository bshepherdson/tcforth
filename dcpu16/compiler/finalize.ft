\ Final file that goes last in the process.
\ This sets Target's LATEST and DP properly.

-1 '.intro ! \ Dummy intro just to stop some incompatible code from running.

host REQUIRE ../../shared/finalizing.ft
host definitions

\ This needs to be the last lines in the target compilation.
\ But not for non-interactive applications.
\ host latest        latest0 tcode!
\ host data-space @      dp0 tcode!

\ HACK: For now I'm implementing my basic app in here.
target definitions

: main ( -- )
  boot
  run-test-suite
  BEGIN AGAIN ;

host T' main   entry-point tcode!


host tcforth-output dump-forth
