target definitions

host keyboard-input? [IF]
  target
  \  01234567890123456789012345678901
  S"        TC-FORTH version 7       " STRING header-str

  :noname ( -- ) white fg! blue ish bg!
    header-str type
    default-colours cr ;
  '.intro !

  :noname ( ch -- ch ) $7f and (printable) ; IS printable
host [THEN]
target

: init-hardware ( -- )
  init-devices init-lem init-serial init-clock ;
