target definitions

:noname ( -- ) white fg! light blue bg!
  \  01234567890123456789012345678901
  ."        TC-FORTH version 7       "
  default-colours cr ;
'.intro !

: init-hardware ( -- )
  init-devices init-lem init-serial   60 hz
  [ host find-time  tliteral target ] 2@ hex. hex. cr
  [ host parse-time tliteral target ] 2@ hex. hex. cr ;

:noname ( ch -- ch ) $7f and (printable) ; IS printable
