target definitions

host keyboard-output? [IF]
  target
  \  01234567890123456789012345678901
  S"        TC-FORTH version 7       " STRING header-str

  :noname ( -- ) white fg! blue ish bg!
    header-str type
    default-colours cr ;
  '.intro !

  :noname ( ch -- ch ) $7f and (printable) ; IS printable
host [THEN]
target

: init-hardware ( -- ) 10 log init-devices 11 log init-lem 12 log init-serial 13 log init-clock ;
