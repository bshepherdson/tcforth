\ Kernel for the DCPU-16.
\ This file runs in the HOST vocabulary, assembling CODE words into the target.
\ We attempt to use macros from model.ft (already loaded) to hide details of
\ the system design.

\ Assembler abstractions:
\ - rsp is the return stack pointer itself
\ - [rsp] is RSP's TOS
\ - ip is the current IP address
\ - [ip] the value found at IP.

\ Assumptions in this code:
\ - Using the DCPU-16 hardware SP as Forth's data stack.
\ - TOS on stack.
\ - A B C X Y are free.
\ - J is reserved. No STI/STD.
\ - UP is a global var.

\ These are HOST vocab words that define assembler words on the Target - their
\ mirror words are regular.
: code      ( "name" -- ) (TCREATE) ;
: end-code  ( -- )        next, ;
\ End marker, but no NEXT.
: end-code-bare ( -- ) ;


\ Standard dictionary headers: link, length+immediate+hidden word, len words of
\ name, code field.

code +        pop peek add,   end-code
code -        pop peek sub,   end-code \ This is correct NOS - TOS order!
code *        pop peek mli,   end-code
code /        pop peek dvi,   end-code
code MOD      pop peek mdi,   end-code
code U/       pop peek div,   end-code
code UMOD     pop peek mod,   end-code
code AND      pop peek and,   end-code
code OR       pop peek bor,   end-code
code XOR      pop peek xor,   end-code
code LSHIFT   pop peek shl,   end-code
code RSHIFT   pop peek shr,   end-code
code ARSHIFT  pop peek asr,   end-code
code 2*       1 # peek shl,   end-code
code 2/       1 # peek asr,   end-code


code INVERT   $ffff # peek xor, end-code
code NEGATE
  0 # ra set,
  pop ra sub,
  ra push set,
end-code

\ Comparison operators all have the same shape with different branches.
: comparison ( if-xt "name" -- )
  >R
  code
    0 # ra set,
    pop pop   R> execute
      -1 # ra set,
    ra push set,
  end-code
;

' ife, comparison =
' ifu, comparison <
' ifl, comparison U<


\ Stack operations
code DUP    peek   push set,  end-code
code DROP   pop    ra   set,  end-code
code OVER   1 picc push set,  end-code

code SWAP
  pop  ra   set,
  pop  rb   set,
  ra   push set,
  rb   push set,
end-code

code ?DUP
  0 # peek ifn,
    peek push set,
end-code

code NIP ( y x -- x )
  pop ra   set,
  ra  peek set,
end-code

code SP@   sp  push set,   end-code
code SP!   pop sp   set,   end-code
code RP@   rz  push set,   end-code
code RP!   pop rz   set,   end-code

code >R    pop  pushrsp,   end-code
code R>    push poprsp,    end-code
code R@    [z]  push set,  end-code

TVARIABLE var_up


code @
  pop  ra   set,
  [a]  push set,
end-code

code !
  pop  ra  set,
  pop  [a] set,
end-code

\ These are identical to @ and ! in DCPU-16.
code C@
  pop  ra   set,
  [a]  push set,
end-code

code C!
  pop  ra  set,
  pop  [a] set,
end-code

\ These store as hi, lo in memory, but push as ( lo hi ) double-words.
code 2@
  pop    ra   set,
  1 [a+] push set,
  [a]    push set,
end-code

code 2!
  pop    ra   set,
  pop    [a]  set,
  pop  1 [a+] set,
end-code

code +!
  pop ra  set,
  pop [a] add,
end-code


\ Leaves I alone. Jump directly into the target's code field.
\ The EXECUTEd word's NEXT will continue after here (eventually).
code EXECUTE
  pop pc set,
end-code-bare

\ Uses the built-in, TechCompliant DCPU LOG instruction to log TOS.
code LOG ( x -- )
  pop log,
end-code
\ Likewise, DCPU BRK
code BREAK ( n -- )
  pop brk,
end-code


\ Variables and core states ==================================================
\ Values in ROM giving the initial LATEST and DP.
label dp0       0 asm,
label latest0   0 asm,

TVARIABLE var_dp
TVARIABLE var_latest
TVARIABLE var_state
TVARIABLE var_handler

data-space @ CONSTANT var_last_parse   2 tcells tdata-allot
data-space @ CONSTANT var_source       2 tcells tdata-allot
TVARIABLE var_in_ptr
TVARIABLE var_source_id

data-space @ CONSTANT input-buf   128 tdata-allot


code ,
label (compile)
  var_dp  # rb  set,
  [b]       rc  set,
  pop       [c] set,
  1 #       [b] add,
end-code

code C,         (compile) # pc set, end-code-bare
code COMPILE,   (compile) # pc set, end-code-bare

code DP           var_dp         # push set, end-code
code HANDLER      var_handler    # push set, end-code
code 'LATEST      var_latest     # push set, end-code
code STATE        var_state      # push set, end-code
code UP           var_up         # push set, end-code
code 'SOURCE      var_source     # push set, end-code
code 'SOURCE-ID   var_source_id  # push set, end-code
code >IN          var_in_ptr     # push set, end-code
code TIB          input-buf      # push set, end-code
code LAST-PARSE   var_last_parse # push set, end-code
code F_IMMED      f_immed        # push set, end-code


code 2DUP
  1 picc push set,
  1 picc push set,
end-code

code 2DROP
  2 # sp add,
end-code


code 2OVER
  3 picc push set,
  3 picc push set,
end-code


code 1+      1 # peek add,   end-code
code CELL+   1 # peek add,   end-code
code CHAR+   1 # peek add,   end-code
code 1-      1 # peek sub,   end-code

\ These are no-ops
code CELLS   end-code
code CHARS   end-code

code CELL   1 # push set,   end-code


\ Double-cell arithmetic
\ TODO 123. double-cell conversion in the >NUMBER interpreter

\ D>S is DROP
code D>S   1 # sp add,  end-code


\ TODO: More double-cell arithmetic?


\ Branches are abstracted, because they differ signficantly on STC systems,
\ and even on others they might prefer relative or absolute branches.
\ ,BRANCH ,DEST and !DEST handle that abstraction between the kernel and the
\ shared high-level Forth control structures.

\ On the DCPU, these are absolute new I values in the next slot of the thread.
code (BRANCH)
  [ip] ip set,
end-code

code (0BRANCH)
  ra <[ip]+,   \ IP advanced; A holds the optional target.
  0 # pop ife,
    ra ip set, \ Branch passed, so set IP to the target.
end-code


code EXIT
  \ Get the target XT for EXIT and stash it in the forward reference.
  code-space @ 'EXIT !

  ip poprsp,
end-code



\ A jsr docol for reference.
label jsr_docol      docol # jsr,
label pfa_tos_code   pfa->tos,
label pfa_tos_code_top

\ DO LOOPs ===================================================================
code UNLOOP ( --    R: limit index -- )
  2 # rz add,
end-code

code I ( -- index    R: index -- index )
  [z] push set,
end-code

code J ( -- index1   R: index1 limit2 index2 -- index1 limit2 index2 )
  2 [z+] push set,
end-code


\ Parsing in native code for speed ===========================================
\ [var_source] is the input area length and, [var_source+1] the input address.
label SKIPPER ( -- )
  var_source    [#] rc set,  \ len        -> C
  var_source 1+ [#] rb set,  \ start_addr -> B
  rb                rx set,  \ start_addr -> X also
  rb                rc add,  \ overrun    -> C
  var_in_ptr    [#] rx add,  \ current    -> X
\ Current offset in X, overrun address in C.
\ If they're equal, just bail out.
  rx rc ife,
    fwd pc set,
label skipper-loop
  bl # [x] ifn,
    fwd pc set,
  1 # rx add,
  rx rc ifn,
    skipper-loop # pc set,

  \ If we're still here, X == C so we've run out of input area.
  \ Two fwd addresses on the stack: finding a non-space and initial overrun.
  \ All of these cases are the same: no more spaces to skip.
  resolve resolve
  \ >IN is an offset; B holds the origin, so X-B is our new offset.
  rb             rx sub,  \ X-B -> X
  rx var_in_ptr [#] set,  \ X   -> >IN
next,

\ Instructions for jumping out of the skipper-loop on finding the *wrong* thing.
$7d73 CONSTANT skip-spaces-branch       \ IFN [x], lit
$7d72 CONSTANT skip-non-spaces-branch   \ IFE [x], lit

code SKIP-SPACES
  SKIP-SPACES-BRANCH     #   skipper-loop [#] set,
  skipper # pc set,
end-code-bare

code SKIP-NON-SPACES
  SKIP-NON-SPACES-BRANCH #   skipper-loop [#] set,
  skipper # pc set,
end-code-bare


\ Call point for CODE usage; registers already set up.
\ NOTE: <FIND> below relies on this preserving C!
label istr=-inner
  ra rb ifn,       \ Length mismatch: instant fail
    fwd pc set,    ( len-<> )

label istr=-loop
  0 # ra ife,      \ A = 0: at the end!
    fwd pc set,    ( len-<> len-0 )
  1 # ra  sub,     \ A - 1 -> A
  [i] rx  set,     \ [I] = ch1 -> X
  [j] ry  sti,     \ [J] = ch1 -> Y,      I++, J++!

  \ Lower case -> Upper case
  'z' 1+ # rx ifl,         \ If X < 'z'+1
    'a' 1- # rx ifg,       \ And X > 'a'-1
      $20 invert # rx and, \ Drop the lower-case bit!
  'z' 1+ # ry ifl,         \ If X < 'z'+1
    'a' 1- # ry ifg,       \ And X > 'a'-1
      $20 invert # ry and, \ Drop the lower-case bit!

  rx ry ife,       \ X = Y: matched, so keep looping. (Length in A already decremented)
    istr=-loop # pc set,

  ( len-<>   len-0 )
  \ Fall through: Character mismatch
  swap resolve \ And Length mismatch  ( len-0 )
  0 # ra set,  \ False flag -> A
  fwd pc set,  ( len-0   done )

  swap resolve \ Matched strings!
  -1 # ra set, \ True -> A

  resolve      \ Done either way, so return. A has the flag.
  pop pc set,


code ISTR= ( addr1 u1 addr2 u2 -- ? )
  pop rb   set,    \ len2  -> B
  pop rj   set,    \ addr2 -> J
  pop ra   set,    \ len1  -> A
  pop rx   set,    \ addr1 -> X for now
  ri  push set,    \ Save the old IP.
  rx  ri   set,    \ addr1 -> I now.
  istr=-inner # jsr, \ A has the flag on the return.
  pop ri   set,    \ Fix IP
  ra push  set,    \ Push the flag
end-code


TVARIABLE find-addr
TVARIABLE find-len

code <FIND> ( c-addr u nt1 -- nt2|0 )
  pop           rc  set, \ Keeping nt in C.
  pop find-len  [#] set,
  pop find-addr [#] set,
  ri           push set, \ Save I

label FIND-loop
  0 # rc ife,
    fwd pc set,          \ Bail if nt is zero
  1 tcells 1 tchars +
               # rj set,    \ off   -> J
  rc             rj add,    \ addr  -> J
  -1 tchars [j+] rb set,    \ len+bits -> B
  mask_len_hidden # rb and, \ len+hidden

  find-addr [#]  ri set, \ addr2 -> I
  find-len  [#]  ra set, \ len2  -> A
  istr=-inner # jsr,     \ A has the flag, 0 or -1

  rc  ra and,            \ A is 0 for no match, or the nt to return!
  [c] rc set,            \ C is the *next* nt now.
  0 # ra ife,
    FIND-loop # pc set,

  \ Still here - we found the match; it's in A.
  ra   rc   set, \ Unifying on the return value in C.

resolve
  pop  ri   set, \ Restore IP
  rc   push set, \ Push the return value
end-code         \ And done!



\ Interrupts =================================================================
\ Most of the interrupt handling is in code_words.ft but these are not since
\ they get inlined by the native build.
code IRQ+ ( -- )   0 # iaq,   end-code \ Interrupts on  = queueing disabled
code IRQ- ( -- )   1 # iaq,   end-code \ Interrupts off = queueing enabled


REQUIRE kernel/code_words.ft
REQUIRE kernel/init.ft
