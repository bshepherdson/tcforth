5 CONSTANT msg-timer
6 CONSTANT msg-transmit
7 CONSTANT msg-receive

\ To keep the interrupt handlers as light as possible, these semaphores are
\ blocked by the
SEMAPHORE clear-to-send
SEMAPHORE data-ready

VARIABLE ticks-count

: int-handler ( msg -- )
  CASE
  msg-timer    OF 1 ticks-count +! ENDOF
  msg-transmit OF clear-to-send signal1 ENDOF
  msg-receive  OF data-ready signal1 ENDOF
  log 0 ENDCASE ;

' int-handler (>interrupt)
msg-timer clock-int!

\ Infinite loop of running the cursor around the board.
24 CONSTANT snake-width
 8 CONSTANT snake-height

 7     black bg green fg CONSTANT snake-ew
 8     black bg green fg CONSTANT snake-ns
 9     black bg green fg CONSTANT snake-nw
10     black bg green fg CONSTANT snake-ne
11     black bg green fg CONSTANT snake-se
12     black bg green fg CONSTANT snake-sw
17     black bg pink  fg CONSTANT snake-ch

: snake-left   ( -- x ) /row snake-width - 2/ 1- ;
: snake-right  ( -- x ) snake-left snake-width + ;
: snake-top    ( -- y ) #rows snake-height - 2/ 1- ;
: snake-bottom ( -- y ) snake-top snake-height + ;

: >snake    ( x y -- addr ) xy> vram + ;
: snake@    ( x y -- ch )   >snake @ ;
: snake!    ( ch x y -- )   >snake ! ;

: snake-horiz ( y -- )
  snake-right snake-left 1+ DO
    snake-ew   i 2 pick snake! LOOP drop ;

: snake-vert ( x -- )
  snake-bottom snake-top 1+ DO
    snake-ns over i snake! LOOP drop ;

: snake-nw! ( -- ) snake-nw   snake-left  snake-top    snake! ;
: snake-ne! ( -- ) snake-ne   snake-right snake-top    snake! ;
: snake-sw! ( -- ) snake-sw   snake-left  snake-bottom snake! ;
: snake-se! ( -- ) snake-se   snake-right snake-bottom snake! ;

: snake-track! ( -- )
  snake-top  snake-horiz   snake-bottom snake-horiz
  snake-left snake-vert    snake-right  snake-vert
  snake-nw! snake-ne! snake-se! snake-sw! ;

\ Running around the track.
VARIABLE snake-loc
VARIABLE snake-under

: snakate  ( -- ) snake-under @ snake-loc @ ! ;
: snarrive ( -- )
  snake-loc @
  dup @ snake-under !
  snake-ch swap ! ;

2 VALUE snake-skip

SEMAPHORE snaker
: snake-to ( x y -- )
  snakate   >snake snake-loc !   snarrive
  snake-skip 0 DO snaker wait LOOP ;

: snaking-n ( -- )
  \ 4 TO snake-skip
  snake-right 1+ snake-left DO i snake-top   snake-to 2 +LOOP ;
: snaking-e ( -- )
  \ 8 TO snake-skip
  snake-bottom snake-top 1+ DO snake-right i snake-to LOOP ;
: snaking-s ( -- )
  \ 4 TO snake-skip
  snake-left 1-  snake-right DO i snake-bottom snake-to   -2 +LOOP ;
: snaking-w ( -- )
  \ 8 TO snake-skip
  snake-top 1+   snake-bottom 1- DO snake-left i snake-to -1 +LOOP ;

: snake-lap ( -- )
  snaking-n snaking-e snaking-s snaking-w ;


: snake-handler ( msg -- )
  CASE
  msg-timer OF snaker signal ENDOF
  ENDCASE ;

: snake-int+ ( -- )
  ['] snake-handler (>interrupt)
  msg-timer clock-int! ;

: snake ( -- )
  clear vacate \ Wipe the screen and disable the cursor.
  snake-track!
  \ Set up the snake state.
  0 0 >snake   dup snake-loc !   @ snake-under !
  \ Kick off the timer interrupts.
  snake-int+
  BEGIN snake-lap AGAIN ;

\ Visualizes the font
: font-spam ( -- )
  clear
  \ Black-on-green header
  black fg! green bg!
  S" 01234567890123456789012345678901" type

  \ White on black font picture
  white fg! black bg!
  128 0 DO i emit LOOP ;



\ Async serial port ==========================================================
\ A separate task takes care of the transmitting and receiving. The ends are
\ separate, there's no requests and responses as pairs. Instead, two small
\ tasks handle reading and writing data from defined buffers.
32 cells TASK transmitter
32 cells TASK receiver

MUTEX xmit-lock
MUTEX recv-lock

CREATE outgoing-msg 2 cells allot
: transmit1 ( -- )
  \ Wait for the receiver to come through.
  6 log
  receive drop ( c-addr -- )
  7 log
  receive drop ( c-addr u -- )
  dup 0= IF 2drop EXIT THEN
  2dup outgoing-msg 2!

  BEGIN
    outgoing-msg 2@
    clear-to-send WAIT
    over c@ semit
    1 /string   tuck outgoing-msg 2!
  0= UNTIL ;
\ TODO: Notify senders when their message is done?


: read-serial ( -- ch status )
  2 $501 dev-serial @ >device ;

\ Receives until either the provided buffer is full or the remote hangs up.
\ The latter is detected by the "no data" error. The hardware will send an
\ interrupt (if enabled) when the remote hangs up.
CREATE incoming-msg 2 cells allot
VARIABLE incoming-start
VARIABLE receiver-callback
VARIABLE incoming-error

: got-byte ( ch -- u-headroom )
  >R   incoming-msg 2@   over R> swap ( c-addr u ch c-addr )
  !   1 /string   tuck incoming-msg 2! ( u ) ;


: receive1 ( -- )
  3 log
  receive 4 log receiver-callback !   receive drop ( c-addr u )
  dup 0= IF 2drop   0 receiver-callback @ send EXIT THEN \ Empty
  over incoming-start !   incoming-msg 2!
  incoming-error OFF
  BEGIN
    \ Wait for the hardware to signal it has data available.
    data-ready WAIT
    \ Then send the read HWI.
    read-serial ( ch status ) CASE
      0 OF got-byte ENDOF
      3 OF drop 0   ENDOF
      drop ENDCASE ( u-left )
  0= UNTIL
  \ At this point, we're done loading the message. Get its length and signal
  \ the requesting task.
  incoming-msg 2@ drop incoming-start @ - ( u-read )
  receiver-callback @ send ;


: transmitter-start ( -- ) transmitter ACTIVATE BEGIN transmit1 AGAIN ;
: receiver-start    ( -- ) receiver    ACTIVATE BEGIN receive1  AGAIN ;

\ Fire-and-forget transmitter. Does NOT wait for the whole message to be sent.
: serial-transmit ( c-addr u -- )
  xmit-lock claim
  swap transmitter send   transmitter send
  xmit-lock release ;

: serial-receive ( c-addr u-space -- u-read )
  recv-lock claim
  swap receiver send   receiver send
  \ That will call us back with the length read.
  receive drop ( u-read )
  recv-lock release ;


\ A=4 Configure. B=3 to enable both, C=receive, X=transmit
: serial-ints+ ( -- )
  \ A=4 Configure. B=3 to enable both, C=receive, X=transmit
  4 3 msg-receive msg-transmit   $f dev-serial @ >device ;
: serial-ints- ( -- )
  4 0 0 0   $f dev-serial @ >device ;

transmitter-start
receiver-start
serial-ints+
