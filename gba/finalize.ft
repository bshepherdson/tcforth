\ Final file that goes last in the process.
\ This sets Target's LATEST and DP properly.
host REQUIRE ../shared/finalizing.ft
host definitions

data-indirect? [IF] prepare-data-initializers [THEN]

\ By this point all the USER variables should be defined. Write the base size
\ into code space since the startup code needs them.
\ TODO: This will need adjusting the get multitasking working.
host

\ For now, just putting the stacks and user variables at the top of IWRAM.
\ The interrupt handler stack is at $03007F00 and up; the Forth stacks go below.
$03007F00 CONSTANT game-iwram-top

game-iwram-top                  'rp0 tcode!
game-iwram-top default/rs - dup 'sp0 tcode!
t/user @ -   $100 cells -   dup 'up0 tcode!
." UP0 " hex. cr


\ At this point the assembler's output region should be complete.
\ Dump the binary!
host tcforth-output dump-forth
