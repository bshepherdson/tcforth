192 allocate throw THERE-PTR cart-header-space
$08000000 cart-header-space space>org !

: read-header-template ( -- )
  S" header.bin" R/O BIN OPEN-FILE throw >R
  cart-header-space space>host-array @   192   R@ READ-FILE throw drop
  R> CLOSE-FILE throw ;

$a0 CONSTANT hdr-game-title
$ac CONSTANT hdr-game-code
$b0 CONSTANT hdr-game-maker
$bd CONSTANT hdr-complement-check

: >hdr ( offset -- ) cart-header-space space>host-array @ + ;

hdr-game-title >hdr   16 erase

S" CHEZZZZZ" hdr-game-title >hdr swap move
S" BCZE"     hdr-game-code  >hdr swap move
S" BS"       hdr-game-maker >hdr swap move

: checksum ( -- checksum )
  0   hdr-complement-check hdr-game-title DO
    i >hdr c@   $19 - $ff and LOOP ;

checksum   hdr-complement-check >hdr c!
