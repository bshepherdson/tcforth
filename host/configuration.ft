\ Defines several configuration parameters which control different parts of
\ the metacompiler, eg. whether code space overlaps data space, whether code
\ space is read-only, whether to include name space and input parsing code, etc.

REQUIRE vocabularies.ft
host definitions

\ Required target parameters =================================================
\ These first few parameters *must* be configured.
\ Their defaults are known to be silly and get checked by ?check-config.
777 CONSTANT config-unset
config-unset VALUE char-bits
config-unset VALUE cell-width      \ In target address units
config-unset VALUE little-endian?
config-unset VALUE threaded?       \ True for threaded code, ie. DTC and ITC.
config-unset VALUE tos-in-reg?     \ True if TOS is in a register.


\ Further target parameters ==================================================
\ Only required if multitasking is enabled, of course.
0 VALUE tasks-desc?     \ True if the task area grows towards lower addresses.


\ Defaulting to cell size ====================================================
\ Some targets need to override these values, but they are commonly the same
\ as the cell size. Override these internal (parenthesized) versions, but call
\ the public ones below to read them.
\ TODO: This feels like a single defining word would do the job better, but I
\ can't get it to work on Gforth 0.7.
0 VALUE (/codeword)
0 VALUE (/exit)
0 VALUE (alignment)

: DEFAULT:CELLS ( addr "name" --   X: -- value )
  CREATE , DOES> @ >body @ dup 0= IF drop cell-width THEN ;

' (/codeword) DEFAULT:CELLS /codeword  \ In target address units
' (/exit)     DEFAULT:CELLS /exit      \ Width of EXIT in a Forth thread
' (alignment) DEFAULT:CELLS alignment  \ Target cell alignment in target address units


\ Optional features ==========================================================
\ Some of these default to on, and some off.
true   VALUE keyboard-input?
true   VALUE keyboard-output?
true   VALUE has-dictionary? \ Have the dictionary and Forth text interpreter?
true   VALUE structures?
false  VALUE multitasking?
false  VALUE debugging?


\ Forth system internals =====================================================
\ These are about the layout of eg. dictionary headers, and are needed when
\ the dictionary is in ROM, so writable data values must be indirected rather
\ than inlined in the dictionary.
\ Default to an inline, writable dictionary, the common configuration.
false  VALUE names-indirect?
false  VALUE data-indirect?
false  VALUE no-data-init?    \ When true, nonzero *writable* data is banned.


\ Setup helpers ==============================================================
: config-terminal! ( -- )
  true TO keyboard-input?
  true TO keyboard-output? ;

: interactive-forth! ( -- )
  config-terminal!
  true TO has-dictionary? ;

: standalone! ( -- )
  false TO has-dictionary?
  true  TO names-indirect? ;

: in-rom! ( -- )
  true TO data-indirect? ;

: rom-application! ( -- )
  standalone! in-rom! ;

: headless! ( -- )
  standalone!
  false TO keyboard-input?
  false TO keyboard-output? ;

\ Config checks ==============================================================
: ?unset ( xt -- )
  dup execute config-unset = IF
    >name id. ." config value must be set" abort
  ELSE drop THEN ;

: ?check-config ( -- )
  ['] char-bits      ?unset
  ['] cell-width     ?unset
  ['] little-endian? ?unset
  ['] threaded?      ?unset
  ['] tos-in-reg?    ?unset

  \ If there's no dictionary on the target, then names-indirect? must be true.
  \ So if both has-dictionary? and names-indirect? are false, there's a problem.
  has-dictionary? names-indirect? or 0=
  ABORT" Targets without the dictionary must have names-indirect? true" ;


\ Helpers ====================================================================
\ Typically 8 or 16, the number of bits per target address unit.
: tcharbits ( -- u )     char-bits ;
: tcells    ( u1 -- u2 ) cell-width * ;
: tchars    ( u1 -- u2 ) ;
: tchar+    ( u1 -- u2 ) 1+ ;
: tcell+    ( u1 -- u2 ) 1 tcells + ;

: taligned  ( tc-addr -- t-addr )
  alignment 1-   tuck +   swap invert and ;

: bits/tcell   ( -- u ) tcharbits tcells ;
: bytes/tcell  ( -- u ) bits/tcell   3 rshift ;
: bytes/tchar  ( -- u ) char-bits    3 rshift ;
: tchar-mask   ( -- u-mask ) 1 char-bits lshift   1- ;


\ Output configuration =======================================================
native definitions
DEFER tcforth-output
:noname ( -- c-addr u )
  pad S" forth-" cat   machine cat   S" .bin" cat
  pad tuck - ; IS tcforth-output

host definitions
