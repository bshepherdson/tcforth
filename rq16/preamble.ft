\ Initial setup for TC-Forth on Risque-16.
: tc-machine S" rq16" ;

REQUIRE ../host/vocabularies.ft
REQUIRE ../host/helpers.ft

host definitions

\ Metacompiler configuration =================================================
host REQUIRE ../host/configuration.ft

interactive-forth!
16     TO char-bits
1      TO cell-width
1      TO (/codeword)   \ Indirect threading

true   TO tos-in-reg?
false  TO little-endian?
true   TO threaded?
false  TO multitasking?
true   TO tasks-desc?

true   TO debugging?

\ Target spaces ==============================================================
REQUIRE ../host/spaces.ft

' <be16@> IS <tc@*>
' <be16!> IS <tc!*>

: spaces::single ( -- )
  single-space!

  $0 code-space ORG! ;

: spaces::separate ( -- )
  true TO data-indirect?
  true TO names-indirect?

  split-spaces!
  $0000 code-space ORG!   $0000 code-space space>offset !
  $2000 name-space ORG!   $4000 name-space space>offset !
  $4000 data-space ORG!   $8000 data-space space>offset ! ;

: spaces::copying ( -- )
  spaces::separate
  data-space space>init-copy? ON
  -1   data-space space>offset ! ;

' spaces::single IS default-spaces!
