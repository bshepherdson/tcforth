\ Control structures, must be loaded after machine-specific branching.
target definitions

target :F IF   ( ? --     C: -- if-slot ) 0BRANCH, ; IMMEDIATE
  host acts: 0BRANCH, ; IMPERATIVE

target :F THEN ( ? --     C: if-slot -- ) >dest swap !dest ; IMMEDIATE
  host acts: >dest swap !dest ; IMPERATIVE
target :F ELSE ( ? --     C: if-slot -- else-slot )
    BRANCH,   swap >dest swap !dest ; IMMEDIATE
  host acts: BRANCH,   swap >dest swap !dest ; IMPERATIVE

target :F BEGIN  ( --       C: -- top-loc ) >dest ; IMMEDIATE
  host acts: >dest ; IMPERATIVE
target :F AGAIN  ( --       C: top-loc -- ) BRANCH, !dest ; IMMEDIATE
  host acts: BRANCH, !dest ; IMPERATIVE
target :F WHILE  ( ? --     C: -- while-slot ) 0BRANCH, ; IMMEDIATE
  host acts: 0BRANCH, ; IMPERATIVE
target :F REPEAT ( --       C: top-loc while-slot )
    swap branch, !dest ( while-slot )
    >dest swap !dest ; IMMEDIATE
  host acts: swap BRANCH, !dest   >dest swap !dest ; IMPERATIVE
target :F UNTIL  ( ? --     C: top-loc -- ) 0BRANCH, !dest ; IMMEDIATE
  host acts: 0BRANCH,   !dest ; IMPERATIVE


target : MOVE  ( src dst u -- ) >R 2dup U< IF R> MOVE> ELSE R> MOVE< THEN ;
