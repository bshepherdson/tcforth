\ Default intro, if there isn't a customized one defined.
host   T' '.intro   t>body tdata@ 0= [IF]
  target definitions
  :noname ." TC-Forth version 7" cr ; '.intro !
host [THEN]

\ For systems without multitasking, we want to have dummy CLAIM, RELEASE, PAUSE, etc.

host definitions

data-indirect? [IF] prepare-data-initializers [THEN]
