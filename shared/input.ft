host <T'> <find> 0=   has-dictionary? and [IF]
\ Implementing <FIND> in code gave a 2x speedup on DCPU-16.
target :F <FIND> ( c-addr u nt -- nt|0 )
  BEGIN dup WHILE
    dup >R name>string   2over istr= IF 2drop R> EXIT THEN
    R> @
  REPEAT ( c-addr u 0 ) 2drop drop 0 ;
host [THEN]

target :F DICT-HASH ( c-addr u -- index )
  [ host dict-hash-len-mask  tliteral target ] and
  [ host /dict-hash-char 0 [DO] T' 2* tcompile, [LOOP] target ]
  swap c@
  [ host dict-hash-char-mask tliteral target ] and or ;

target :F >BUCKET ( index -- 'nt )
  cells [ host dict-buckets tliteral target ] + ;

\ Internal formulation of FIND with a stacked string, not a counted string.
\ Returns 1 for IMMEDIATE words, -1 for regular words, 0 for not found.
target :F (FIND) ( c-addr u -- 0 | xt 1 | xt -1 )
  2dup dict-hash >bucket @   <FIND> ( nt|0 )
  dup IF \ Found something! ( nt )
    dup >cfa swap        ( xt nt )
    cell+ c@ [ host f_immed tliteral target ] and
    ( xt immed? ) IF 1 ELSE -1 THEN
  THEN ;

target :F FIND ( c-addr -- c-addr 0 | xt 1 | xt -1 )
  dup >R   count (find)   dup IF R> drop ELSE drop R> 0 THEN ;


target : /STRING ( c-addr u n -- c-addr2 u2 ) tuck - >R   + R> ;

target :F PARSE ( delim "...<delim>" -- c-addr u )
  source >IN @ /string   over >R   rot >R ( c-addr u   R: start delim )
  BEGIN dup WHILE
    over c@ R@ = IF \ End of string
      R> 2drop ( end   R: start ) R> tuck - ( start len )
      \ Advance >IN by len+1 since len excludes the delimiter.
      dup 1+ >IN +!
      EXIT THEN
    1 /string
  REPEAT ( c-addr 0   R: start delim )
  1000 >IN +! R> R> 2drop ;

host <T'> skip-spaces 0= [IF]
target :F SKIP-SPACES ( -- )
  BEGIN source >in @ /string WHILE \ Not empty  ( c-addr )
    c@ bl <> IF EXIT THEN
    1 >IN +!
  REPEAT drop ;
host [THEN]

host <T'> skip-non-spaces 0= [IF]
target :F SKIP-NON-SPACES ( -- )
  BEGIN source >in @ /string WHILE \ Not empty  ( c-addr )
    c@ bl = IF EXIT THEN
    1 >IN +!
  REPEAT drop ;
host [THEN]

target :F PARSE-NAME ( "<spaces>name<space>" -- c-addr u )
  skip-spaces
  source drop     >IN @ ( src start )
  skip-non-spaces >IN @ ( src start end )

  \ Bump the input pointer to after the space, unless at end-of-line.
  source >in @ /string IF 1 >IN +! THEN drop
  over -                ( src start len )
  >R + R> ;


target :F ' ( "name" -- xt ) parse-name (find) 0= IF err-undefined throw THEN ;
  host acts: T' ;

target :F POSTPONE ( "name" -- )
  parse-name (find)
  1 = IF compile, ELSE
    \ Regular word
    [ host t' literal tcompile, target ] \ Compiling the xt as a literal
    [ host t' compile, tliteral target ] compile, \ And compiling compile,
  THEN ; IMMEDIATE
  host acts: (T') dup mirror>txt @   swap mirror-immediate? IF tcompile, ELSE
    [ has-dictionary? [IF] ]
      tliteral   [T'] compile, tcompile,
    [ [ELSE] ] drop [ [THEN] ]
  THEN ; IMPERATIVE

target :F ['] ( "name" --    X: -- xt )
    ' postpone literal ; IMMEDIATE
  host acts: T' tliteral ; IMPERATIVE


host REQUIRE case.ft
host REQUIRE strings.ft


target definitions

\ Basic, unsigned number parsing.
\ Tries to parse as many digits according to BASE as possible.
\ TODO: Reword this into a state machine or otherwise optimize it? Unclear how
\ much time is spent here in evaluating a typical file.
target : >NUMBER ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
  BEGIN
    >R dup >R c@ ( ud1 ch )
    dup [ host '0' tliteral '9' 1+ tliteral target ] WITHIN IF
      [ host '0' tliteral target ] -
    ELSE
      dup [ host 'A' tliteral 'Z' 1+ tliteral target ] WITHIN IF
        [ host 'A' tliteral target ] -
      ELSE
        dup [ host 'a' tliteral 'z' 1+ tliteral target ] WITHIN IF
          [ host 'a' tliteral target ] -
        ELSE ( Bad digit! )
          drop 10000
        THEN
      THEN
      10 + \ A=10, not 0
    THEN ( ud1 digit )
    dup base @ U< IF \ Legal digit, merge it in.
      >R base @ UDM* ( ud*base ) R> S>D D+ ( ud*base+digit )
      R> R> 1 /string dup 0= IF ( ud1 c-addr u ) EXIT THEN
      \ If we're still here, we're set up to loop back.
    ELSE
      \ That digit was illegal. Return the un-advanced string.
      drop R> R> EXIT
    THEN ( ud c-addr u )
  AGAIN ;


\ Tries to parse a number, fully fancy, with - and $ prefixes.
target : ?NUMBER ( c-addr u -- n true | false )
  base @ >R   0 >R ( c-addr u    R: old-base neg? )
  over c@ [ host '-' tliteral target ] = IF R> drop -1 >R   1 /string THEN
  over c@ [ host '$' tliteral target ] = IF 16 base !       1 /string THEN
  0 0 2swap >number ( ud c-addr u ) 0= IF \ Parsed successfully!
    drop D>S   R> IF negate THEN   R> base !   -1
  ELSE \ Failed to parse
    drop 2drop R> drop R> base ! 0
  THEN ;

host presume .

\ Interprets a single parsed word or number.
target :F INTERP1   ( c-addr u -- )
  2dup last-parse 2!
  2dup (find) ?dup IF ( c-addr u xt 1|-1 )
    2swap 2drop ( xt 1|-1 )
    state @ IF
      0> IF execute ELSE compile, THEN
    ELSE
      drop execute
    THEN
  ELSE ( c-addr u )
    ?number ( n true | false ) IF ( n )
      state @ IF [ host t' literal tcompile, target ] THEN
    ELSE ( )
      \ Really undefined. Emit an error message.
      err-undefined throw
    THEN
  THEN
  depth 0< IF err-underflow throw THEN ;

\ Fundamental single-line interpreter loop.
target :F INTERPRET ( -- )
  BEGIN parse-name dup WHILE interp1 REPEAT 2drop ;

host presume ACCEPT presume EMIT presume REVERSE presume CR
target
