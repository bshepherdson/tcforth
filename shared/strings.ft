\ String handling, S" in interp and compile states, and ."
target definitions

target :F CHAR   ( "<spaces>name" -- char ) parse-name drop c@ ;
  host acts: char ;
target :F [CHAR] ( "<spaces>name" --    X: -- char )
    parse-name drop c@   postpone literal ; IMMEDIATE
  host acts: char tliteral ; IMPERATIVE

\ Following the standard, S" ." and .( are only supported in definitions.
host definitions
: (S")
  '"' parse
  ,dostring ;
target definitions

target :F S" ( "ccc"" --     X: -- c-addr u )
    [ host '"' tliteral target ]
    parse ( c-addr u )   state @ IF ,dostring ELSE
      2dup here swap move   nip here swap THEN ; IMMEDIATE
  host acts: state @ IF (S") ELSE '"' parse THEN ; IMPERATIVE-BOTH

\ Compiles an interpretation-time string as r/o-data into the target.
\ Defines a new word that works like a 2CONSTANT, ( -- c-addr u ).
target :F STRING ( c-addr u "name" --    X: -- c-addr u )
    CREATE dup ,   here swap   dup allot   move   align
    DOES> dup cell+ swap @ ;
  host acts:
    \ We don't want to use CREATE, it'll put the string in the writable data.
    \ Instead, directly compile the string with tcode, and then put its address
    \ and length into a 2CONSTANT.
    ." Top of STRING (HOST) "
    dup >R code-space @ .s cr >R
    0 ?DO ( c-addr ) dup i chars + c@ tcode-c, LOOP
    drop R> R> ( 'contents u )
    dup tchars tcode-allot   tcode-align
    (TCREATE) ,docol .s cr swap tliteral tliteral exit, ;

\ Forward reference to TYPE, resolved later.
host presume type

\ Indirection so this word can be compiled directly and its contents are the
\ forward reference.
\ TODO: This kinda sucks - it's a metacompiler weakness with target-side impact.
\ Fix it so that forward references can work for values pushed as literals.
\ Doing that portably between ITC/DTC and STC is hard, though, since literals
\ are not just in the thread in that case.
target :F <type> type ;

target :F ." ( "ccc"" --   X: -- ) postpone S"  ['] <type> compile, ; IMMEDIATE
  host acts: (S")   [T'] <type> tcompile, ; IMPERATIVE

\ Compile-time print
target :F .( ( "ccc<paren>" -- ) [char] ) parse type ; IMMEDIATE
  host acts: [char] ) parse type ; IMPERATIVE
