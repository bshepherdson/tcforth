\ Only loaded when structures are enabled.
\ These follow the Standard.
target definitions

\ TODO: These should have HOST ACTS: defined so that they can be run on the host
\ during metacompilation.

:F begin-structure ( "name" -- struct-sys 0 ) CREATE here 0   0 , DOES> @ ;
:F end-structure   ( struct-sys +n -- ) swap ! ;

:F +field ( offset1 +n "name" -- offset2    X: addr -- addr+offset1 )
  CREATE   over ,   +   DOES> @ + ;

:F cfield: ( u1 "name" -- u2   X: addr -- addr+u1 ) 1 +field ;
:F field:  ( u1 "name" -- u2   X: addr -- addr+u1 ) aligned 1 cells +field ;
:F 2field: ( u1 "name" -- u2   X: addr -- addr+u1 ) aligned 2 cells +field ;
