\ Multitasking code!
\ Only REQUIREd:
\ (1) on targets that support it, and
\ (2) when multitasking? is true.
host REQUIRE linked.ft

target definitions


\ XXX: The current definition is not safe for preemptive schemes!
\ That would require words to disable and re-enable interrupts, which are
\ machine-dependent and not defined yet.

\ TODO: Consider task alignment - eg. on machines with caches it would be good
\ to have the stacks aligned on eg. 64- or 256-byte boundaries for speed.

\ Task area ==================================================================
target VARIABLE task-area

\ Allots u address units in the task area; returning the address at the start.
host tasks-desc? [IF]
  \ Downward-growing task area: task-area points at the most recent task.
  target : task-allot ( u -- task ) negate task-area +!   task-area @ ;
host [ELSE]
  \ Upward-growing task area: points at next free byte.
  target : task-allot ( u -- task ) task-area @ tuck +   task-area ! ;
host [THEN]


\ Task creation ==============================================================
target : newtask* ( u-data u-return -- task )
  2dup /user + +   dup task-allot >R ( u-data u-return size   R: task )
  rot  /stack  R@ 's !
  over /rstack R@ 's ! ( u-return size    R: task )
  R@ +                 ( u-return top     R: task )
  dup    rp0 R@ 's ! \ Write top as RP0
  swap - sp0 R@ 's ! \ And top minus u-return as SP0 ( R: task )
  \ Copy any more starter vars: BASE.
  base @   base R@ 's !
  R> ;

\ Creates a new task with stacksize address units for *each* of its stacks.
target : newtask ( stacksize -- task ) dup newtask* ;
target :F task ( stacksize "name" --    X: -- task ) newtask CONSTANT ;

\ Returns the *data* stack size of the current task.
target : stacksize ( -- u ) /stack @ ;

target : stacksize* ( -- u-data u-return ) /stack @   /rstack @ ;


\ Cooperative scheduling =====================================================
\ Technically the multitasker starts disabled, and must be enabled with MULTI.
\ It can be disabled with SINGLE.
\ This is implemented by toggling whether PAUSE is the real (PAUSE) or NOOP.
target   ' noop ' pause defer!

\ High-level PAUSE implementation - which calls (PAUSE) with the task as TOS.
target : <PAUSE> ( -- )
  link @ (PAUSE) ;

target : MULTI  ( -- )
  ['] <pause> ['] pause defer! ;
target : SINGLE ( -- )
  ['] noop    ['] pause defer! ;


\ Given a task, find the task which points to it as its LINK.
target : PREV-TASK ( task1 -- task2 )
  link 2@ ( prev next ) drop ;

\ Removes a target task from the round-robin ring of tasks.
target : SLEEP ( task -- ) link swap 's duck ;

\ SLEEPs the current task so it will not run again.
\ Hands off to the next ready task like PAUSE.
target : STOP ( -- )
  link @     ( next )
  up@ SLEEP  ( next )
  (PAUSE) ;

\ WAKEs a task so it will run. The awakened task goes in the front of the queue,
\ and this task immediately PAUSEs to let the new one run.
target : <WAKE> ( task -- ) link q+ ;
target : WAKE   ( task -- ) <wake> PAUSE ;


\ Printing ===================================================================
target : .task ( task -- )
  >R
  ." Task: " R@ hex. cr
  ."      IP: " task-code R@ 's      hex. cr
  ."  Thread: " task-code R@ 's
      dup @ hex.   cell+ dup @ hex.   cell+ dup @ hex.   cell+ @ hex. cr
  ."      SP: " task-sp   R@ 's @    hex. cr
  ."   Stack: " sp0       R@ 's @    task-sp R@ 's @ ( sp0 sp )
  over hex. dup hex. cr
  2dup - 1 cells /   >R
  DO i @   1 cells +LOOP   R>          ( x1 .. xn depth )
  BEGIN ?dup WHILE swap hex. 1- REPEAT ( R: task )
  cr R> drop ;


\ Killing tasks ==============================================================
\ In a system without GC, tasks are forever. Since this is a bare metal system
\ we don't assume there's a virtual memory system or OS to handle that sort of
\ thing. Still, this is a useful API, and something needs to happen when a task
\ reaches the end of its xt.

\ KILL-TASK is current equivalent to STOP - it removes the current task from
\ the ring of running tasks, and PAUSEs to let the next task run.
\ It will never run again unless it gets INITIATEd again with a new xt.
\ Technically killing a task is stronger than stopping it, but that's not a
\ major concern.
target : KILL-TASK ( -- ) STOP ;

\ Kicking off tasks ==========================================================
\ Pushes a value to the stack of a task.
target : >task ( x task -- )
  [ host tsp tliteral target ] +   ( x 'sp )
  -1 cells over +! \ Decrement the stack pointer ( x 'sp )
  @ ! ;

host tos-in-reg? [IF]
  target : tos>task ( task -- ) $deadbeef swap >task ;
host [ELSE]
  target : tos>task ( task -- ) drop ;
host [THEN]


target : (initiate) ( xt task -- task )
  \ ." Top of (initiate) " hex.s cr
  >R
  sp0 R@ 's @   task-sp R@ 's ! \ Set the task's SP to its SP0.
  R@ link q+                    \ Enqueue the new task right after current.
  R@ tos>task                   \ This is a no-op if TOS is not in a register
  rp0 R@ 's @   R@ >task        \ Push RP0 into the task's stack
  dp @                          \ Save DP so we can compile
  task-code R@ 's   dp !        \ DP points to pseudothread
  here R@ >task  ( xt dp )      \ It's also the starting IP
  swap compile,   ['] kill-task compile, ( ) \ Pseudothread now ready!
  dp !   R> ;

\ The fundamental word to kick off a task.
\ Task stacks need to have ( (user-tos) rsp ip ) in their stacks.
\ So the process is:
\ 1. Set up the data stack pointer for the task.
\ 2. Push those 2 (or 3) values.
\ 3. Compile the xt and kill-task into the pseudothread in the user area.
target : initiate ( xt task -- )
  (initiate) drop \ .task
  pause ;


\ Creating tasks =============================================================
\ Here are DOES>-like ways to call INITIATE than with a literal xt and task ptr.

\ Example usage:
\ 64 cells TASK some-task
\ : start-something   some-task ACTIVATE code for some-task ;

\ The resulting thread for start-something looks like this:
\ [ ... (ACTIVATE) EXIT   codeword   code for some-task ... ]
\ (ACTIVATE) needs to push the xt = the address of the codeword.
\ We already have the pieces of this since it resembles (DOES>).
target : (ACTIVATE) ( task -- )
  \ Get the implied xt. The TORS points at EXIT in the thread.
  R@ [ host /exit tliteral target ] + swap initiate ;


target :F ACTIVATE ( C: colon-sys1 -- colon-sys2    X: task -- )
    \ NOTE: Runs during a : definition likes DOES> !
    ['] (activate) compile,
    [ host EXIT-compile, target ]
    reveal
    \ NOT switching back to interpreter state.
    ,docol       \ Compile a docol code field.
    \ Keep compiling the rest.
  ; IMMEDIATE
\ On the host, the logic is basically the same.
  host acts:
    [T'] (activate) tliteral   [T'] compile, tcompile,
    exit,   ,docol
  ; IMPERATIVE
target


: (PASS) ( xn ... x1 n task -- task )
  >R BEGIN ?dup WHILE dup pick R@ >task   1- REPEAT R> ;

\ TODO: Write (PASS) and PASS.
\ (PASS) copies the stack values to the task, preserving the task in TOS; it
\ is followed by (ACTIVATE) as normal.
\ PASS compiles (PASS) then does ACTIVATE.

target : INIT-MULTI ( -- )
  [ host task-area0 tliteral target ]   dup task-area !
  up@ - abs   task-allot drop \ Making space for the startup task.
  link encircle ; \ Link kernel task to itself, it's the only one running.


\ Like WORDS, prints out the current state of all running or ready tasks.
target : TASKS ( -- )
  \ ['] pause defer@ >R   single
  cr up@ hex. ."    <-- running"
  link @ BEGIN up@ over <> WHILE
    cr dup hex.
    link swap 's @
  REPEAT
  drop   ; \ R> ['] pause defer! ;


\ Semaphores =================================================================
\ Semaphores are stored as [ count | wait-queue ]
\ WAIT checks the count. If it's positive decrement and continue.
\ If count is zero, put this thread to SLEEP and append it to the wait-queue.

\ SIGNAL checks the queue - if there's anyone waiting, they get removed from
\ wait-queue and queued up next in the main LINK round-robin queue.

\ TODO: One approach to interrupts is a machine code handler that unblocks a
\ Forth thread that's waiting on a semaphore. But that's a bit tricky to do
\ with the linked lists out of the box.
\ I think if Forth handlers will work, that's more the style we're looking for.

\ NOTE: It's important that semaphores and mutexes both have their wait queues
\ in the first slot.
target :F SEMAPHORE ( "name" --    X: -- semaphore ) CREATE 0 , 1 , DOES> ;
  host acts: CREATE host 0 tdata, 1 tdata, DOES> ;

target : <WAIT-ON> ( 'queue -- )
  up@ SLEEP
  dup @ IF ( 'queue )
    @ up@ +q
  ELSE
    up@ swap !
  THEN ;

target : WAIT ( sem -- )
  irq-   dup cell+ @ IF -1 swap cell+ +! ELSE <WAIT-ON> THEN   irq+ ;

\ Dequeues a waiting task and returns it. If there's nothing queued, returns 0.
\ The returned task is DUCKed out of the waiting queue.
target : <UNBLOCK> ( 'queue -- waiting-task|0 )
  dup @ ?dup 0= IF drop 0 EXIT THEN
  \ ( 'q blocked ) — at least one task is waiting.
  dup link> @ over <> IF \ More tasks waiting after it!
    dup link> @    ( 'q blocked next )
    swap duck >R   ( 'q next   R: blocked )
    swap ! R>      ( blocked )
  ELSE
    swap off ( blocked )
  THEN ;

\ SIGNAL will unblock the next task in wait-queue, if any. If there are none,
\ the count is incremented instead.
target : <SIGNAL> ( sem  -- )
  <unblock> ?dup IF <wake> ELSE 1 swap +! THEN ;

target : SIGNAL  ( addr -- ) irq-   <SIGNAL>   irq+ ;

\ SIGNAL> is "signal and go"; it PAUSEs to allow anyone waiting to run first.
target : SIGNAL> ( addr -- ) signal pause ;

\ SIGNAL1 sets a cell to exactly 1. This will unblock anyone trying to WAIT on
\ it, but prevent double-counting.
target : SIGNAL1 ( addr -- )
  irq-
  dup <signal>
  cell+ dup @ 1 min swap ! \ Only valid values are 0 and 1.
  irq+ ;


\ Nestable mutexes ===========================================================
\ These are "free" if they're 0 and if nonzero only the claiming task can
\ nest it further.
\ Can't actually use BEGIN-STRUCTURE.
target
3 cells CONSTANT [MUTEX]
: mutex>waiters ( mutex -- 'waiters ) ;
: mutex>nesting ( mutex -- 'nesting ) cell+ ;
: mutex>task    ( mutex -- 'task )    2 cells + ;

target : MUTEX ( "name" --    X: -- mutex ) CREATE [MUTEX] allot align DOES> ;
  host acts: CREATE 0 tdata, 0 tdata, 0 tdata, DOES> ;

\ Waits until the mutex is free, then claims it.
\ If this task has already claimed it, increases the nesting level.
target : <CLAIM>   ( mutex -- )
  irq-
  dup mutex>task @ ?dup IF ( mutex locked-by )
    up@ = IF ( mutex )
      1 swap mutex>nesting +!
    ELSE <WAIT-ON> THEN
  ELSE \ ( mutex ) Nothing currently locking it, so set the task and nesting 1.
    up@ over mutex>task !
    1 swap mutex>nesting !
  THEN irq+ ;
' <CLAIM> IS CLAIM

target : <NESTING--> ( mutex -- new-nesting )
  mutex>nesting dup @   1- dup >R   ( 'nesting new-nesting   R: new-nesting )
  swap ! R> ;

target : <RELEASE> ( mutex -- )
  irq-
  dup <nesting--> 0= IF \ Nested drained to 0, so unblock. ( mutex )
    dup <unblock> ?dup IF \ Wake up the next blocked task ( mutex blocked )
      dup <wake>
      \ Also claim the MUTEX on its behalf!
      over mutex>task !
      1 swap mutex>nesting ! ( )
    ELSE \ Nobody waiting, so just leave it unblocked.
      ( mutex ) 0 swap mutex>task !
    THEN
  ELSE \ Still nested, just carry on.
    drop
  THEN irq+ ;
' <RELEASE> IS RELEASE

\ Core locks =================================================================
target here   [mutex] allot   IS termlock


\ Message passing ============================================================
: SEND ( msg task -- )
  sender over 's   BEGIN pause dup @ 0= UNTIL   ( msg task 'sender )
  single
  up@ swap !    ( msg task )
  message swap 's ! ( )
  multi ;

: RECEIVE ( -- message task )
  BEGIN pause   sender @ UNTIL
  single
  message @ sender @
  0 sender !
  multi ;
