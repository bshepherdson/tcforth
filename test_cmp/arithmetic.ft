\ Arithmetic

\ +
: test-+ ( -- )
  T{        0   5 + ->          5 }T
  T{        5   0 + ->          5 }T
  T{        0  -5 + ->         -5 }T
  T{       -5   0 + ->         -5 }T
  T{        1   2 + ->          3 }T
  T{        1  -2 + ->         -1 }T
  T{       -1   2 + ->          1 }T
  T{       -1  -2 + ->         -3 }T
  T{       -1   1 + ->          0 }T
  T{ MID-UINT   1 + -> MID-UINT+1 }T ;

\ -
: test-- ( -- )
  T{          0    5 - ->       -5 }T
  T{          5    0 - ->        5 }T
  T{          0   -5 - ->        5 }T
  T{         -5    0 - ->       -5 }T
  T{          1    2 - ->       -1 }T
  T{          1   -2 - ->        3 }T
  T{         -1    2 - ->       -3 }T
  T{         -1   -2 - ->        1 }T
  T{          0    1 - ->       -1 }T
  T{ MID-UINT+1    1 - -> MID-UINT }T ;

\ 1+
: test-1+ ( -- )
  T{        0 1+ ->          1 }T
  T{       -1 1+ ->          0 }T
  T{        1 1+ ->          2 }T
  T{ MID-UINT 1+ -> MID-UINT+1 }T ;

\ 1-
: test-1- ( -- )
  T{          2 1- ->        1 }T
  T{          1 1- ->        0 }T
  T{          0 1- ->       -1 }T
  T{ MID-UINT+1 1- -> MID-UINT }T ;


\ ABS
: test-abs ( -- )
  T{       0 ABS ->          0 }T
  T{       1 ABS ->          1 }T
  T{      -1 ABS ->          1 }T
  T{ MIN-INT ABS -> MID-UINT+1 }T ;

\ NEGATE
: test-negate ( -- )
  T{  0 NEGATE ->  0 }T
  T{  1 NEGATE -> -1 }T
  T{ -1 NEGATE ->  1 }T
  T{  2 NEGATE -> -2 }T
  T{ -2 NEGATE ->  2 }T ;


\ Multiplication
: test-* ( -- )
  T{  0  0 * ->  0 }T
  T{  0  1 * ->  0 }T
  T{  1  0 * ->  0 }T
  T{  1  2 * ->  2 }T
  T{  2  1 * ->  2 }T
  T{  3  3 * ->  9 }T
  T{ -3  3 * -> -9 }T
  T{  3 -3 * -> -9 }T
  T{ -3 -3 * ->  9 }T

  T{ MID-UINT+1 1 RSHIFT 2 * -> MID-UINT+1 }T
  T{ MID-UINT+1 2 RSHIFT 4 * -> MID-UINT+1 }T
  T{ MID-UINT+1 1 RSHIFT MID-UINT+1 OR 2 * -> MID-UINT+1 }T ;

\ Division
: test-/mod ( -- )
  T{   0   1  /MOD ->   0   0 }T
  T{   1   1  /MOD ->   0   1 }T
  T{   2   1  /MOD ->   0   2 }T
  T{  -1   1  /MOD ->   0  -1 }T
  T{  -2   1  /MOD ->   0  -2 }T
  T{   0  -1  /MOD ->   0   0 }T
  T{   7   3  /MOD ->   1   2 }T
  T{  -7   3  /MOD ->  -1  -2 }T
  T{   7  -3  /MOD ->   1  -2 }T
  T{  -7  -3  /MOD ->  -1   2 }T ;

: test-suite-arithmetic ( -- )
  test-+  test--
  test-1+ test-1-
  test-abs
  test-negate
  test-*
  test-/mod ;
