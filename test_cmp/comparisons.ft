\ Comparison helpers

\ These are functions rather than constants so that they're executed on the
\ target side and not on the host.
: MAX-UINT   ( -- u ) 0 invert                 ;
: MAX-INT    ( -- n ) 0 invert 1 rshift        ;
: MIN-INT    ( -- n ) 0 invert 1 rshift invert ;
: MID-UINT   ( -- u ) 0 invert 1 rshift        ;
: MID-UINT+1 ( -- u ) 0 invert 1 rshift invert ;

0S CONSTANT <FALSE>
1S CONSTANT <TRUE>

\ Comparisons: 0= =
: test-0= ( -- )
  T{  0       0= -> <TRUE>  }T
  T{  1       0= -> <FALSE> }T
  T{  2       0= -> <FALSE> }T
  T{ -1       0= -> <FALSE> }T
  T{ MAX-UINT 0= -> <FALSE> }T
  T{ MIN-INT  0= -> <FALSE> }T
  T{ MAX-INT  0= -> <FALSE> }T ;

: test-= ( -- )
  T{  0  0 = -> <TRUE>  }T
  T{  1  1 = -> <TRUE>  }T
  T{ -1 -1 = -> <TRUE>  }T
  T{  1  0 = -> <FALSE> }T
  T{ -1  0 = -> <FALSE> }T
  T{  0  1 = -> <FALSE> }T
  T{  0 -1 = -> <FALSE> }T ;

\ Comparsions: 0< <
: test-0< ( -- )
  T{       0 0< -> <FALSE> }T
  T{      -1 0< -> <TRUE>  }T
  T{ MIN-INT 0< -> <TRUE>  }T
  T{       1 0< -> <FALSE> }T
  T{ MAX-INT 0< -> <FALSE> }T ;

: test-< ( -- )
  T{       0       1 < -> <TRUE>  }T
  T{       1       2 < -> <TRUE>  }T
  T{      -1       0 < -> <TRUE>  }T
  T{      -1       1 < -> <TRUE>  }T
  T{ MIN-INT       0 < -> <TRUE>  }T
  T{ MIN-INT MAX-INT < -> <TRUE>  }T
  T{       0 MAX-INT < -> <TRUE>  }T

  T{     0         0 < -> <FALSE> }T
  T{     1         1 < -> <FALSE> }T
  T{     1         0 < -> <FALSE> }T
  T{     2         1 < -> <FALSE> }T
  T{     0        -1 < -> <FALSE> }T
  T{     1        -1 < -> <FALSE> }T
  T{     0   MIN-INT < -> <FALSE> }T
  T{ MAX-INT       0 < -> <FALSE> }T
  T{ MAX-INT MIN-INT < -> <FALSE> }T ;

\ Comparsions: >
: test-> ( -- )
  T{       0       1 > -> <FALSE> }T
  T{       1       2 > -> <FALSE> }T
  T{      -1       0 > -> <FALSE> }T
  T{      -1       1 > -> <FALSE> }T
  T{ MIN-INT       0 > -> <FALSE> }T
  T{ MIN-INT MAX-INT > -> <FALSE> }T
  T{       0 MAX-INT > -> <FALSE> }T

  T{       0       0 > -> <FALSE> }T
  T{       1       1 > -> <FALSE> }T
  T{       1       0 > -> <TRUE>  }T
  T{       2       1 > -> <TRUE>  }T
  T{       0      -1 > -> <TRUE>  }T
  T{       1      -1 > -> <TRUE>  }T
  T{       0 MIN-INT > -> <TRUE>  }T
  T{ MAX-INT       0 > -> <TRUE>  }T
  T{ MAX-INT MIN-INT > -> <TRUE>  }T ;

\ Comparsions: U<
: test-U< ( -- )
  T{        0        1 U< -> <TRUE>  }T
  T{        1        2 U< -> <TRUE>  }T
  T{        0 MID-UINT U< -> <TRUE>  }T
  T{        0 MAX-UINT U< -> <TRUE>  }T
  T{ MID-UINT MAX-UINT U< -> <TRUE>  }T
  T{        0        0 U< -> <FALSE> }T
  T{        1        1 U< -> <FALSE> }T
  T{        1        0 U< -> <FALSE> }T
  T{        2        1 U< -> <FALSE> }T
  T{ MID-UINT        0 U< -> <FALSE> }T
  T{ MAX-UINT        0 U< -> <FALSE> }T
  T{ MAX-UINT MID-UINT U< -> <FALSE> }T ;

\ Comparisons: MIN
: test-min ( -- )
  T{       0       1 MIN ->       0 }T
  T{       1       2 MIN ->       1 }T
  T{      -1       0 MIN ->      -1 }T
  T{      -1       1 MIN ->      -1 }T
  T{ MIN-INT       0 MIN -> MIN-INT }T
  T{ MIN-INT MAX-INT MIN -> MIN-INT }T

  T{       0 MAX-INT MIN ->       0 }T
  T{       0       0 MIN ->       0 }T
  T{       1       1 MIN ->       1 }T
  T{       1       0 MIN ->       0 }T
  T{       2       1 MIN ->       1 }T
  T{       0      -1 MIN ->      -1 }T
  T{       1      -1 MIN ->      -1 }T
  T{       0 MIN-INT MIN -> MIN-INT }T
  T{ MAX-INT       0 MIN ->       0 }T
  T{ MAX-INT MIN-INT MIN -> MIN-INT }T ;

\ MAX
: test-max ( -- )
  T{       0       1 MAX ->       1 }T
  T{       1       2 MAX ->       2 }T
  T{      -1       0 MAX ->       0 }T
  T{      -1       1 MAX ->       1 }T
  T{ MIN-INT       0 MAX ->       0 }T
  T{       0 MAX-INT MAX -> MAX-INT }T
  T{ MIN-INT MAX-INT MAX -> MAX-INT }T

  T{       0       0 MAX ->       0 }T
  T{       1       1 MAX ->       1 }T
  T{       1       0 MAX ->       1 }T
  T{       2       1 MAX ->       2 }T
  T{       0      -1 MAX ->       0 }T
  T{       1      -1 MAX ->       1 }T
  T{       0 MIN-INT MAX ->       0 }T
  T{ MAX-INT       0 MAX -> MAX-INT }T
  T{ MAX-INT MIN-INT MAX -> MAX-INT }T ;


: test-suite-comparisons ( -- )
  test-0= test-=
  test-0< test-<
  test->
  test-U<
  test-min test-max ;
