\ Memory basics
HERE 1 , HERE 2 ,
CONSTANT 2ND CONSTANT 1ST

: test-memory-basics ( -- )
  T{       1ST 2ND U< -> <TRUE> }T
  T{       1ST cell+  -> 2ND }T
  T{   1ST 1 cells +  -> 2ND }T
  T{     1ST @ 2ND @  -> 1 2 }T
  T{         5 1ST !  ->     }T
  T{     1ST @ 2ND @  -> 5 2 }T
  T{         6 2ND !  ->     }T
  T{     1ST @ 2ND @  -> 5 6 }T
  T{           1ST 2@ -> 6 5 }T
  T{       2 1 1ST 2! ->     }T
  T{           1ST 2@ -> 2 1 }T
  T{ 1S 1ST !  1ST @  -> 1S  }T ;

\ +!  BITS
: BITS ( X -- U )
   0 SWAP BEGIN DUP WHILE
     DUP MSB AND IF >R 1+ R>
     THEN 2* REPEAT DROP ;

: test-+! ( -- )
  T{ 0  1ST  !        ->         }T
  T{ 1  1ST +!        ->         }T
  T{    1ST  @        -> 1       }T
  T{ -1 1ST +! 1ST @  -> 0       }T
  T{ 1  1    <        -> <FALSE> }T
  T{ 1  1  MOD        -> 0       }T
  T{ 1S BITS 10 <     -> <FALSE> }T ;

\ ALLOT
\ NOTE: Yes, these tests are legit on a compiled, non-interactive target!
\ They're testing that the host-side HERE, ALLOT and ALIGN all compile the
\ right things.
HERE 1 ALLOT
HERE ALIGN
CONSTANT 2NDA
CONSTANT 1STA

: test-allot ( -- )
  T{ 1STA 2NDA U< -> <TRUE> }T
  T{      1STA 1+ ->   2NDA }T ;


\ BL CHAR [CHAR]  [ ]
: GC1 [CHAR] X   ;
: GC2 [CHAR] HELLO ;

CHAR X     CONSTANT CHAR-X
CHAR HELLO CONSTANT CHAR-HELLO

: test-chars ( -- )
  T{ BL -> 32 }T
  T{ CHAR-X -> 88 }T
  T{ CHAR-HELLO -> 72 }T

  T{ GC1 -> 88 }T
  T{ GC2 -> 72 }T ;

\ S"
S" XY" STRING "XY"

: test-STRING ( -- )
  T{ "XY" SWAP DROP  -> 2 }T
  T{ "XY" DROP DUP c@ SWAP 1+ c@ -> 88 89 }T ;

\ IF ELSE THEN
: GI1 IF 123 THEN ;
: GI2 IF 123 ELSE 234 THEN ;

: test-if-else-then ( -- )
  T{  0 GI1 ->     }T
  T{  1 GI1 -> 123 }T
  T{ -1 GI1 -> 123 }T
  T{  0 GI2 -> 234 }T
  T{  1 GI2 -> 123 }T
  T{ -1 GI1 -> 123 }T ;

\ Multiple ELSEs in an IF
: melse IF 1 ELSE 2 ELSE 3 ELSE 4 ELSE 5 THEN ;

: test-multiple-elses ( -- )
  T{ <FALSE> melse -> 2 4 }T
  T{ <TRUE>  melse -> 1 3 5 }T ;

\ BEGIN WHILE REPEAT 1
: GI3 BEGIN DUP 5 < WHILE DUP 1+ REPEAT ;
: test-begin-while-repeat ( -- )
  T{ 0 GI3 -> 0 1 2 3 4 5 }T
  T{ 4 GI3 -> 4 5 }T
  T{ 5 GI3 -> 5 }T
  T{ 6 GI3 -> 6 }T ;

\ BEGIN UNTIL
: GI4 BEGIN DUP 1+ DUP 5 > UNTIL ;

: test-begin-until ( -- )
  T{ 3 GI4 -> 3 4 5 6 }T
  T{ 5 GI4 -> 5 6 }T
  T{ 6 GI4 -> 6 7 }T ;

\ CASE statements ==================================================
: GS1 CASE ENDCASE ;
: GS2 CASE 1 OF 10 ENDOF   2 OF 100 ENDOF   3 OF 1000 ENDOF 0 ENDCASE ;
: test-case-stmts ( -- )
  T{  4 GS1 -> }T
  T{  1 GS2 -> 10   }T
  T{  2 GS2 -> 100  }T
  T{  3 GS2 -> 1000 }T
  T{  4 GS2 -> 4    }T
  T{ -1 GS2 -> -1   }T ;

\ \ VALUE and TO =====================================================
5 VALUE GV1
: GV1! 6 TO GV1 ;
\ Note that *compiling* TO above doesn't change the value!

: test-value-to ( -- )
  T{ GV1      -> 5 }T
  T{ 8 TO GV1 ->   }T
  T{ GV1      -> 8 }T

  T{ GV1      -> 8 }T
  T{ GV1!     ->   }T
  T{ GV1      -> 6 }T ;

\ Test suite =================================================================
: test-suite-rest ( -- )
  test-memory-basics
  test-+!
  test-allot
  test-chars test-STRING
  test-if-else-then
  test-multiple-elses
  test-begin-while-repeat
  test-begin-until
  test-case-stmts
  test-value-to ;
