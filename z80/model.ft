\ ===================== MACHINE/MODEL DEPENDENT SECTION ======================
\ Trying to keep the system as portable across both machines and Forth models
\ as possible. model.ft implements a few key routines (eg. DOCOL) and assembler
\ macros (eg. pushrsp,) to hide the details of the model as much as possible.

\ NOTE: I'm running with the Moving Forth example Z80. In Part 1 he gives one
\ example allocation but the complete CamelForth source later on uses a
\ different one that seems better to me.
\ DTC, 16-bit cells, 8-bit chars and address units.
\ BC = Forth TOS   (top of parameter stack)
\ HL =       W     working register
\ DE =       IP    Interpreter Pointer
\ SP =       PSP   Parameter Stack Pointer
\ IX =       RSP   Return Stack Pointer
\ IY =       UP    User area pointer

\ First the inner interpreter: NEXT, ENTER, EXIT
\ DTC ========================================================================

\ Standard dictionary headers: link, length+immediate+hidden word, len words of
\ name, code field.

\ This is a little surprising, but it makes sense when you think deeper:
\ NATIVE HERE pushes the Host's dictionary pointer.
\ HOST   HERE pushes the Target's dictionary pointer
\ TARGET HERE is the mirror word that compiles the Target xt for HERE (!)
HOST DEFINITIONS

\ The assembler defines a THERE pointer for the Target dictionary.
\ We capture that address as the HOST DP as well.
there CONSTANT DP
: here dp @ ;
$8000 dp !   \ Earliest byte that isn't contended etc.

: tc,       ( b -- )  assemble ;   \ Byte-width assemble.
: t,        ( w -- )  assemble16 ; \ Word-width assemble.
: tc@ b@ ;
: tc! b! ;


\ First line of code, the entry point. It'll be a jump to COLD eventually.
$8000 call,


\ These are pseudooperands that hide what registers are used for what.
: rsp     ( -- op ) ix   ;
: w       ( -- op ) hl   ;
: [w]     ( -- op ) [hl] ;
: ip      ( -- op ) de   ;
: [ip]    ( -- op ) [de] ;
: tos     ( -- op ) bc   ;

\ Assembler macros ===========================================================
\ NEXTHL - NEXT, where HL already contains the IP to use.
: nexthl, ( -- )
  e [hl] ld-r,r   \ 1B 7c   cfa_lo -> W_lo
  hl     inc-rr,  \ 1B 6c   IP++
  d [hl] ld-r,r   \ 1B 7c   cfa_hi -> W_hi
  hl     inc-rr,  \ 1B 6c   IP++
         ex-de,hl \ 1B 4c   IP <-> W
  [hl]   jp,      \ 1B 4c  = 6B 34c
;

\ NEXT - jump to (IP++), post-incrementing
: next, ( -- )  ex-de,hl   nexthl, ;  \ 1B 4c  + NEXTHL 6B 34c = 7B 38c.
\ So that's longer and slower... but mine doesn't leave the address in an
\ accessible register. I'm not sure how much that matters.


\ Called like E D pushrsp, and see below for the rr versions.
: lh-pushrsp, ( lo hi -- )
  ix   dec-rr,
  0 ix ld-r,(i+#)
  ix   dec-rr,
  0 ix ld-r,(i+#) ;

: lh-poprsp,  ( lo hi -- )
  swap     ( hi lo )
  0 ix ld-(i+#),r
  ix   inc-rr,
  0 ix ld-(i+#),r
  ix   inc-rr, ;

: rr->lh ( rr -- lo hi )
  CASE
  bc OF c b ENDOF
  de OF e d ENDOF
  hl OF l h ENDOF
  throw
  ENDCASE ;

: rr-pushrsp, ( rr -- ) rr->lh lh-pushrsp, ;
: rr-poprsp,  ( rr -- ) rr->lh lh-poprsp,  ;


: tcompile, tcode, ;

VARIABLE 'latest   \ Host var holding the Target nt of the last word defined.
: LATEST ( -- nt ) 'latest @ ;
0 'latest !


\ DOCOL and DODOES are callable routines, they can go wherever.

\ This is called by CALL so the parameter field address is on the data stack.
label DOCOL
  ip rr-pushrsp, \ Save the old IP onto the return stack.
  hl pop,        \ Get the PFA from the data stack (it was the return address)
  nexthl,        \ And call it.

\ DOVAR is the code word for a CREATEd definition without a DOES> - it pushes
\ the address of the parameter field.
\ See the DOES> design below.
\ TOS is in BC, NOS is [SP], which is where the PFA is. So this is a SWAP.
label DOVAR
  hl pop,    \ PFA -> HL
  bc push,   \ old-TOS -> NOS position
  c l ld-r,r \ PFA_lo -> C
  b h ld-r,r \ PFA_hi -> B   new TOS now in place
  next,



\ DOES> design for DTC =======================================================
\ This is different from the original TC-Forth DODOES scheme.
\ Sequence 1: while eg. : CONSTANT create , DOES> @ ; is being defined.
\ Sequence 2: while CONSTANT is running, defining a new constant.
\ Sequence 3: while a particular constant is executing.

\ DOES> is an immediate word, it runs during "Sequence 1".
\ It compiles   (DOES>) EXIT dodoes-asm   at the end of CONSTANT.
\ Then the Forth code after DOES> is compiled. The final CONSTANT looks like:
\ link | len | CONSTANT | CALL docol | CREATE | , | (DOES>) | EXIT |
\ dodoes-code | @ | EXIT
\ Sequence 2 (eg. 7 CONSTANT FOO) CREATEs the new header with the default
\ CALL DOVAR in its code field, but then (DOES>) runs and patches it to
\ CALL &dodoes-code as above, ie. after the EXIT:
\ link | len | FOO | CALL &dodoes-code | 7

\ In DTC, the dodoes-code is entered with the parameter field (pointer to 7)
\ already on the stack, because that's what's after the code field of FOO and
\ was pushed by the CALL.

\ The actual dodoes-code can be simply CALL DOCOL as well in this system, since
\ that will enter the thread with IP pointing at the right place! That's nice
\ because it's fast and compact.

\ This HOST word is invoked by Host-side DOES> to compile the necessary pieces.
VARIABLE '(DOES>)
VARIABLE 'EXIT   \ These get populated later.

: DOES, ( -- xt-does ) '(DOES>) @ t,   'EXIT @ t,   here   DOCOL call, ;


\ Not really words, just assembler routines.
\ TODO: Maybe these are better as mirror words without Target-side headers?

\ [IP] is the number we want in TOS.
label LIT
  tos push,      \ Push old TOS.
  ex-de,hl       \ DE <-> HL
  c [hl] ld-r,r  \ TOS_lo
  hl     inc,    \ Bump
  b [hl] ld-r,r  \ TOS_hi
  hl     inc,    \ Bump
  ex-de,hl       \ DE <-> HL
  next,

label DOSTRING
  \ Next byte in the thread is the length, then that many characters.
  tos push,        \ Push old TOS
  a [de] ld-a,(rr) \ Length into A.
  de  inc,         \ DE points at the string now
  de  push,        \ Push the address into the NOS position.
  e   add,         \ A contains the low byte.
  e a ld-r,r       \ IP_lo -> E
  a   xor,         \ 0 -> A
  d   adc,         \ IP_hi -> D     - No alignment on Z80.
  next,


\ Compiles the code field (address) for a colon declaration.
\ For DTC that means assembling a CALL docol.
: ,docol ( -- ) docol call, ;

\ Compiles the CALL DOVAR.
: ,dovar ( -- ) dovar call, ;

\ Compiles a string literal into the thread.
\ In ITC/DTC that's DOSTRING, then the length, then the chars.
: ,dostring ( c-addr u -- )
  dostring tcompile,
  dup tc,
  ( c-addr u ) BEGIN ?dup WHILE 1- >R   dup c@ tc,   1+ R> REPEAT drop ;

\ Overwrites the code field (address) of the word at word-xt to point to the
\ ;CODE or DOES> at does-xt.
\ On DTC Z80, word-xt points to a CALL, so the address needs to be adjusted.
\ It's pointing at the CALL opcode, not the address.
: !dodoes ( does-xt word-xt -- ) 1+ w! ;


\ Compile a literal. This is in the model because eg. STC doesn't use the two-
\ cell [LIT|x] pattern.
: tliteral ( x --    X: -- x ) lit tcompile,   t, ;

: ,dest ( dest -- ) t, ;
: !dest ( dest slot -- ) t! ;

: t>body ( target-xt -- target-body ) 3 tchars + ;


\ $ff58 and up is reserved.
$ff50 CONSTANT rp0 \ $58 = 88 bytes, 44 cells of RSP.
$ff00 CONSTANT sp0

label entry-point 0 asm,
